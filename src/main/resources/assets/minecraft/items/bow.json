                "model": {
                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling2/netherite"
                },
                "when": "netherite"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling2/prismarine"
                },
                "when": "prismarine"
              },
              {
