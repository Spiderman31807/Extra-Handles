                  "model": "extra_handles:item/bow/pulling2/wooden"
                },
                "when": "wooden"
              }
            ],
            "fallback": {
                "type": "minecraft:model",
                "model": "minecraft:item/bow_pulling_2"
            },
            "property": "extra_handles:type"
          },
          "threshold": 0.9
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "cases": [
          {
            "model": {
              "type": "minecraft:model",
              "model": "extra_handles:item/bow/pulling0/amethyst"
            },
