{
  "model": {
    "type": "minecraft:condition",
    "on_false": {
      "type": "minecraft:select",
      "cases": [
        {
          "model": {
            "type": "minecraft:model",
            "model": "extra_handles:item/bow/amethyst"
          },
          "when": "amethyst"
        },
        {
          "model": {
            "type": "minecraft:model",
            "model": "extra_handles:item/bow/armadillo"
          },
          "when": "armadillo"
        },
        {
          "model": {
            "type": "minecraft:model",
            "model": "extra_handles:item/bow/bone"
          },
          "when": "bone"
        },
        {
          "model": {
            "type": "minecraft:model",
            "model": "extra_handles:item/bow/breeze"
          },
          "when": "breeze"
        },
        {
          "model": {
            "type": "minecraft:model",
            "model": "extra_handles:item/bow/echo"
          },
          "when": "echo"
        },
        {
          "model": {
            "type": "minecraft:model",
            "model": "extra_handles:item/bow/netherite"
          },
          "when": "netherite"
        },
        {
          "model": {
