                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling2/breeze"
                },
                "when": "breeze"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling2/echo"
