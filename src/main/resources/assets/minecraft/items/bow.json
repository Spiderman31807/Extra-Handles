                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling1/netherite"
                },
                "when": "netherite"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling1/prismarine"
                },
                "when": "prismarine"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling1/scute"
                },
                "when": "scute"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling1/wooden"
                },
                "when": "wooden"
              }
            ],
            "fallback": {
                "type": "minecraft:model",
                "model": "minecraft:item/bow_pulling_1"
            },
            "property": "extra_handles:type"
          },
          "threshold": 0.65
        },
        {
          "model": {
            "type": "minecraft:select",
            "cases": [
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling2/amethyst"
                },
