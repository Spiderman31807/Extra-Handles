                },
                "when": "bone"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling1/breeze"
                },
                "when": "breeze"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling1/echo"
                },
                "when": "echo"
              },
              {
