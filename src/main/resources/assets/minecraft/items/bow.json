          },
          {
            "model": {
              "type": "minecraft:model",
              "model": "extra_handles:item/bow/pulling0/netherite"
            },
            "when": "netherite"
          },
          {
            "model": {
              "type": "minecraft:model",
              "model": "extra_handles:item/bow/pulling0/prismarine"
            },
            "when": "prismarine"
          },
          {
            "model": {
              "type": "minecraft:model",
              "model": "extra_handles:item/bow/pulling0/scute"
            },
            "when": "scute"
          },
          {
            "model": {
              "type": "minecraft:model",
              "model": "extra_handles:item/bow/pulling0/wooden"
            },
