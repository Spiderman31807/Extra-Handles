          "when": "scute"
        },
        {
          "model": {
            "type": "minecraft:model",
            "model": "extra_handles:item/bow/wooden"
          },
          "when": "wooden"
        }
      ],
      "fallback": {
          "type": "minecraft:model",
          "model": "minecraft:item/bow"
      },
      "property": "extra_handles:type"
    },
    "on_true": {
      "type": "minecraft:range_dispatch",
      "entries": [
        {
          "model": {
            "type": "minecraft:select",
            "cases": [
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "extra_handles:item/bow/pulling1/amethyst"
                },
                "when": "amethyst"
              },
              {
